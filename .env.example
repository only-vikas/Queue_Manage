# QueueOS Environment Variables Configuration
# Required for Vercel Deployment & Local Development

# MongoDB Atlas Connection URI pointing to your queue database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/queueos?retryWrites=true&w=majority

# Secret key for JWT session cookies
JWT_SECRET=your-32-plus-character-cryptographically-secure-random-secret-key-here

